# Copy to .env and fill in. .env is gitignored — keep it that way.
#
#   cp .env.example .env
#   echo "ROOT_KEY=$(openssl rand -hex 32)" >> .env

# ---- payments (nginx + ngx-l402) -------------------------------------------

# Signs the L402 macaroons the paywall issues. Required.
# Generate with: openssl rand -hex 32
ROOT_KEY=

# Payment backend: LNURL (static Lightning address) or NWC (Nostr Wallet
# Connect). LNURL can mint invoices but not confirm settlement; NWC can do
# both. See docs/payments.md.
LN_CLIENT_TYPE=LNURL

# LNURL mode: the Lightning address that receives payments. Must be a REAL,
# resolvable address — the module fetches
# https://<domain>/.well-known/lnurlp/<name> at startup and crash-loops nginx
# if it 404s. Enforced even when l402_dry_run is on.
LNURL_ADDRESS=you@example.com

# NWC mode only: nostr+walletconnect://…  Leave blank for LNURL mode.
# This is a wallet credential — treat it like a password.
NWC_URI=

# ---- application (sqzd) -----------------------------------------------------

# The origin users actually type. NIP-98 signatures are bound to the absolute
# request URL, so a mismatch here silently fails every signature.
SQZ_BASE_URL=http://localhost:8000

# The NIP-05 domain served at /.well-known/nostr.json.
SQZ_DOMAIN=localhost

SQZ_LOG_LEVEL=info

# Guards POST /admin/rebuild. Leave unset to disable that endpoint entirely
# (fails closed — an unset token never means "no token required").
SQZ_ADMIN_TOKEN=

# ---- deployment -------------------------------------------------------------

# Host port for nginx. Move it if 8000 is already taken on the box.
SQZ_PORT=8000

# Bare canonical domain for Traefik routing, e.g. example.com. Must match the
# host in SQZ_BASE_URL. Only needed when deploying behind Traefik.
SQZ_HOST=

# Optional: override the nginx + ngx-l402 image, e.g. to run a locally-patched
# build.
SQZ_NGINX_IMAGE=

# ---- analytics (optional) ---------------------------------------------------

# Public Firebase web config (public identifiers, not secrets — served to the
# browser via /api/config). Leave the API key empty to disable analytics; the
# frontend also gates on user consent, so setting these alone tracks no one.
SQZ_FIREBASE_API_KEY=
SQZ_FIREBASE_AUTH_DOMAIN=
SQZ_FIREBASE_PROJECT_ID=
SQZ_FIREBASE_STORAGE_BUCKET=
SQZ_FIREBASE_MESSAGING_SENDER_ID=
SQZ_FIREBASE_APP_ID=
SQZ_FIREBASE_MEASUREMENT_ID=

# ---- diagnostics ------------------------------------------------------------

L402_PERF_LOG=false
RUST_LOG=
